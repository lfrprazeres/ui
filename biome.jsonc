{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": ["!dist", "!storybook-static", "!coverage"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "../components": "Layering violation: elements must not import from components. Dependency direction is one-way (elements -> components -> features).",
              "../components/index": "Layering violation: elements must not import from components.",
              "@/components": "Layering violation: elements must not import from components."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      // src/elements is vendored from the shadcn registry and re-scaffolded by
      // the CLI. It is formatted to house style so diffs stay readable, but
      // authoring rules that would force a fork are relaxed here:
      //
      //   noLeakedRender  - false positive, the guards are typed booleans
      //
      // The 200-line cap is likewise not applied to this directory
      // (dropdown-menu is a ~257-line compound component upstream).
      "includes": ["src/elements/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noLeakedRender": "off"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/components/**", "../components*"],
                    "message": "Layering violation: src/elements must not import from src/components. Elements are the floor of the system."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
