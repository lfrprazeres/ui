{
  "name": "@lfrprazeres/ui",
  "version": "0.0.0",
  "description": "A React design system: shadcn elements, composed components, and a three-tier token contract.",
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "shadcn",
    "tailwindcss",
    "radix-ui"
  ],
  "homepage": "https://ui.luizprazeres.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfrprazeres/ui.git"
  },
  "license": "MIT",
  "author": "Luiz Fernando Prazeres <lfrprazeres@gmail.com>",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./elements": "./dist/elements/index.js",
    "./components": "./dist/components/index.js",
    "./styles.css": "./dist/styles.css",
    "./tokens/*": "./dist/tokens/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "check": "ultracite check",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css",
    "check:rsc": "node scripts/check-rsc-directives.mjs",
    "check:size": "size-limit",
    "fix": "ultracite fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm build && pnpm check:rsc && pnpm check:package && pnpm check:size",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "ultracite": "^7.10.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^24.x",
    "pnpm": ">=11"
  }
}
